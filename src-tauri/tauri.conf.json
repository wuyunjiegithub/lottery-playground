{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "概率游乐场",
  "version": "1.0.0",
  "identifier": "com.playground.lottery",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "概率游乐场",
        "width": 470,
        "height": 900,
        "minWidth": 360,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "msi", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "概率游乐场 · 仅供数据分析与娱乐"
  }
}
